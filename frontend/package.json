{
  "name": "app-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write 'src/**/*.{ts,svelte,html,css}' --plugin prettier-plugin-svelte",
    "format:check": "prettier --check 'src/**/*.{ts,svelte,html,css}' --plugin prettier-plugin-svelte",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/svelte": "^5.0.0",
    "@types/node": "^25.6.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.4.0",
    "prettier-plugin-svelte": "^3.3.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
