# Local-only overrides. Copy to `.env` and edit as needed.
# docker-compose reads .env automatically from the project root.
#
# Container ports stay canonical inside the Docker network (Postgres
# listens on 5432, backend on 8000, Vite on 5173). Only the HOST-side
# port bindings shift, so other services on the host can coexist.

# Host ports — change these if 5432/8000/5173 are already in use on
# your machine (e.g. another dev environment is running).
DB_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
