{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    ":dependencyDashboard",
    ":rebaseStalePrs",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone",
    ":timezone(Europe/Amsterdam)"
  ],
  "rangeStrategy": "pin",
  "automerge": true,
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchCategories": [
        "docker"
      ],
      "registryAliases": {
        "public.ecr.aws/docker/library": "docker.io/library"
      }
    }
  ]
}
